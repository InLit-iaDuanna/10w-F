{
  "$defs": {
    "ActorType": {
      "enum": [
        "user",
        "agent",
        "service",
        "system"
      ],
      "title": "ActorType",
      "type": "string"
    }
  },
  "$id": "https://sceneops.local/schemas/core/v1/actor-reference.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "display_name": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Name"
    },
    "id": {
      "pattern": "^(?:usr|agt|svc|sys)_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "title": "Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/ActorType"
    }
  },
  "required": [
    "type",
    "id"
  ],
  "title": "ActorReference",
  "type": "object"
}
