  "components": {
    "schemas": {
      "DocumentSave": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "payload": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "payload"
        ],
        "title": "DocumentSave"
      },
      "FolderEntry": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "kind": {
            "type": "string",
            "enum": [
              "directory",
              "symlink"
            ],
            "title": "Kind"
          },
          "selectable": {
            "type": "boolean",
            "title": "Selectable"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "path",
          "kind",
          "selectable"
        ],
        "title": "FolderEntry"
      },
      "FolderListing": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "parent_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Path"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/FolderEntry"
            },
            "type": "array",
            "title": "Entries"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "parent_path",
          "entries"
        ],
        "title": "FolderListing"
      },
      "FolderProject": {
        "properties": {
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "root_path": {
            "type": "string",
            "title": "Root Path"
          },
          "project_kind": {
            "type": "string",
            "enum": [
              "sceneops_created",
              "existing_unadopted",
              "legacy"
            ],
            "title": "Project Kind",
            "default": "legacy"
          },
          "root_available": {
            "type": "boolean",
            "title": "Root Available",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "project_id",
          "name",
          "root_path"
        ],
        "title": "FolderProject"
      },
      "FolderProjectCreate": {
        "properties": {
          "parent_path": {
            "type": "string",
            "minLength": 1,
            "title": "Parent Path"
          },
          "name": {
            "type": "string",
            "maxLength": 160,
