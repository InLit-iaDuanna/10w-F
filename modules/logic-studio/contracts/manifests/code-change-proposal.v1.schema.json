{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneops.example/schemas/logic-studio/code-change-proposal.v1.schema.json",
  "title": "CodeChangeProposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "graph_id", "graph_version", "base_version", "target_paths", "target_sceneops_ids", "unified_diff", "rationale", "expected_result", "impact_scope", "risk", "validation_plan", "rollback_plan", "mode"],
  "properties": {
    "proposal_id": {"type": "string", "minLength": 1},
    "graph_id": {"type": "string", "minLength": 1},
    "graph_version": {"type": "integer", "minimum": 1},
    "base_version": {"type": "string", "minLength": 1},
    "target_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^Assets/.+\\.cs$"}},
    "target_sceneops_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unified_diff": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "expected_result": {"type": "string", "minLength": 1},
    "impact_scope": {"type": "string", "minLength": 1},
    "risk": {"enum": ["low", "medium", "high"]},
    "validation_plan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollback_plan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "mode": {"const": "planned"}
  }
}
