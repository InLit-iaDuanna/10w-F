{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneops.example/schemas/logic-studio/gameplay-graph.v1.schema.json",
  "title": "GameplayGraph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "project_id", "feature_spec_id", "version", "mode", "state_variables", "events", "scene_objects", "nodes", "edges", "relationships", "acceptance_criteria", "generated_tests"],
  "properties": {
    "schema_version": {"const": 1},
    "graph_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "feature_spec_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "mode": {"$ref": "#/$defs/executionMode"},
    "state_variables": {"type": "array", "items": {"$ref": "#/$defs/stateVariable"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "scene_objects": {"type": "array", "items": {"$ref": "#/$defs/sceneObject"}},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "acceptance_criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}},
    "generated_tests": {"type": "array", "items": {"$ref": "#/$defs/testReference"}}
  },
  "$defs": {
    "executionMode": {"enum": ["live", "cached", "mock", "planned", "blocked"]},
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "variable_id", "operator", "value"],
      "properties": {
        "condition_id": {"type": "string", "minLength": 1},
        "variable_id": {"type": "string", "minLength": 1},
        "operator": {"enum": ["equals", "not_equals", "greater_than", "greater_than_or_equal", "less_than", "less_than_or_equal", "contains", "not_contains"]},
        "value": {}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "variable_id", "operation"],
      "properties": {
        "effect_id": {"type": "string", "minLength": 1},
        "variable_id": {"type": "string", "minLength": 1},
        "operation": {"enum": ["set", "increment", "decrement", "add", "remove", "toggle"]},
        "value": {}
      }
    },
    "stateVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable_id", "label", "value_type", "initial_value"],
      "properties": {
        "variable_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "value_type": {"enum": ["boolean", "integer", "number", "string", "string_set"]},
        "initial_value": {}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "description"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "sceneObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneops_id", "display_name", "scene_id"],
      "properties": {
        "sceneops_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "scene_id": {"type": "string", "minLength": 1}
      }
    },
    "quest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quest_id", "objective_key", "completion_event_id"],
      "properties": {
        "quest_id": {"type": "string", "minLength": 1},
        "objective_key": {"type": "string", "minLength": 1},
        "completion_event_id": {"type": "string", "minLength": 1}
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choice_id", "text_key", "target_node_id", "conditions"],
      "properties": {
        "choice_id": {"type": "string", "minLength": 1},
        "text_key": {"type": "string", "minLength": 1},
        "target_node_id": {"type": "string", "minLength": 1},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}}
      }
    },
    "dialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialogue_id", "speaker_sceneops_id", "line_key", "choices"],
      "properties": {
        "dialogue_id": {"type": "string", "minLength": 1},
        "speaker_sceneops_id": {"type": "string", "minLength": 1},
        "line_key": {"type": "string", "minLength": 1},
        "choices": {"type": "array", "items": {"$ref": "#/$defs/choice"}}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "label"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["start", "state", "interaction", "quest", "dialogue", "feedback", "ending"]},
        "label": {"type": "string", "minLength": 1},
        "sceneops_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}, "default": []},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}, "default": []},
        "emitted_event_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
        "acceptance_criterion_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
        "quest": {"$ref": "#/$defs/quest"},
        "dialogue": {"$ref": "#/$defs/dialogue"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "source_node_id", "target_node_id"],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "source_node_id": {"type": "string", "minLength": 1},
        "target_node_id": {"type": "string", "minLength": 1},
        "event_id": {"type": "string", "minLength": 1},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}, "default": []},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}, "default": []},
        "emitted_event_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "source_sceneops_id", "target_sceneops_id", "relation_type", "template_id"],
      "properties": {
        "relationship_id": {"type": "string", "minLength": 1},
        "source_sceneops_id": {"type": "string", "minLength": 1},
        "target_sceneops_id": {"type": "string", "minLength": 1},
        "relation_type": {"type": "string", "minLength": 1},
        "template_id": {"type": "string", "minLength": 1}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "description"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "testReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "test_kind", "target_node_ids", "acceptance_criterion_ids"],
      "properties": {
        "test_id": {"type": "string", "minLength": 1},
        "test_kind": {"enum": ["edit_mode", "play_mode", "behavior"]},
        "target_node_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "acceptance_criterion_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
