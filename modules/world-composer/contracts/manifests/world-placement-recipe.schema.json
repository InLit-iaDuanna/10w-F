{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneops.local/contracts/world-composer/world-placement-recipe.v1.schema.json",
  "title": "World Placement Recipe v1",
  "oneOf": [
    { "$ref": "#/$defs/graybox" },
    { "$ref": "#/$defs/grid" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schemaVersion", "recipeId", "recipeVersion", "seed", "constraints", "coordinateSystem", "kind"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "recipeId": { "type": "string", "minLength": 1 },
        "recipeVersion": { "type": "string", "minLength": 1 },
        "seed": { "type": "string", "minLength": 1 },
        "constraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "coordinateSystem": { "const": { "units": "meters", "handedness": "right", "upAxis": "Y", "forwardAxis": "-Z" } }
      }
    },
    "graybox": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "type": "object", "required": ["pieces"], "properties": { "kind": { "const": "graybox-explicit-v1" }, "pieces": { "type": "array", "minItems": 1 } } }
      ]
    },
    "grid": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["asset", "instanceSceneopsIds", "origin", "columns", "rows", "columnSpacingMeters", "rowSpacingMeters"],
          "properties": {
            "kind": { "const": "procedural-grid-v1" },
            "columns": { "type": "integer", "minimum": 1 },
            "rows": { "type": "integer", "minimum": 1 },
            "columnSpacingMeters": { "type": "number", "exclusiveMinimum": 0 },
            "rowSpacingMeters": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    }
  }
}
