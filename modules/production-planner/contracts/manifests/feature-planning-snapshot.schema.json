{
  "$defs": {
    "ExecutionMode": {
      "enum": [
        "live",
        "cached",
        "mock",
        "planned",
        "blocked"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "FeatureAcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "required_evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Evidence",
          "type": "array"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "workstreams": {
          "items": {
            "$ref": "#/$defs/Workstream"
          },
          "minItems": 1,
          "title": "Workstreams",
          "type": "array"
        }
      },
      "required": [
        "criterion_id",
        "statement",
        "workstreams",
        "required_evidence"
      ],
      "title": "FeatureAcceptanceCriterion",
      "type": "object"
    },
    "FeatureSpecReference": {
      "additionalProperties": false,
      "properties": {
        "feature_id": {
          "minLength": 1,
          "title": "Feature Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "project_id",
        "feature_id",
        "revision"
      ],
      "title": "FeatureSpecReference",
      "type": "object"
    },
    "Workstream": {
      "enum": [
        "design",
        "concept",
        "asset",
        "animation",
        "world",
        "logic",
        "ui",
        "audio",
        "vfx",
        "render",
        "build",
        "test"
      ],
      "title": "Workstream",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptance_criteria": {
      "items": {
        "$ref": "#/$defs/FeatureAcceptanceCriterion"
      },
      "minItems": 1,
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "feature_ref": {
      "$ref": "#/$defs/FeatureSpecReference"
    },
    "source_contract_version": {
      "minLength": 1,
      "title": "Source Contract Version",
      "type": "string"
    },
    "source_mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "feature_ref",
    "source_contract_version",
    "title",
    "summary",
    "acceptance_criteria",
    "source_mode"
  ],
  "title": "FeaturePlanningSnapshot",
  "type": "object"
}
