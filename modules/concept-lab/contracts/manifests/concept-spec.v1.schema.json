{
  "$defs": {
    "ConceptStatus": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "rejected"
      ],
      "title": "ConceptStatus",
      "type": "string"
    },
    "DimensionsMeters": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "exclusiveMinimum": 0,
          "title": "Depth",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "unit": {
          "const": "m",
          "default": "m",
          "title": "Unit",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height",
        "depth"
      ],
      "title": "DimensionsMeters",
      "type": "object"
    },
    "PlatformBudget": {
      "additionalProperties": false,
      "properties": {
        "max_material_slots": {
          "exclusiveMinimum": 0,
          "title": "Max Material Slots",
          "type": "integer"
        },
        "max_texture_size_px": {
          "exclusiveMinimum": 0,
          "title": "Max Texture Size Px",
          "type": "integer"
        },
        "max_triangles": {
          "exclusiveMinimum": 0,
          "title": "Max Triangles",
          "type": "integer"
        },
        "target_platform": {
          "minLength": 1,
          "title": "Target Platform",
          "type": "string"
        }
      },
      "required": [
        "target_platform",
        "max_triangles",
        "max_texture_size_px",
        "max_material_slots"
      ],
      "title": "PlatformBudget",
      "type": "object"
    },
    "RequiredView": {
      "enum": [
        "front",
        "back",
        "left",
        "right",
        "top",
        "bottom",
        "three_quarter",
        "turnaround"
      ],
      "title": "RequiredView",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authored_by": {
      "title": "Authored By",
      "type": "string"
    },
    "concept_id": {
      "title": "Concept Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dimensions": {
      "$ref": "#/$defs/DimensionsMeters"
    },
    "feature_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feature Id"
    },
    "forbidden_elements": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Elements",
      "type": "array"
    },
    "gameplay_function": {
      "minLength": 1,
      "title": "Gameplay Function",
      "type": "string"
    },
    "materials": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Materials",
      "type": "array"
    },
    "platform_budget": {
      "$ref": "#/$defs/PlatformBudget"
    },
    "project_bible_version_id": {
      "minLength": 1,
      "title": "Project Bible Version Id",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "proportions": {
      "minLength": 1,
      "title": "Proportions",
      "type": "string"
    },
    "reference_ids": {
      "items": {
        "type": "string"
      },
      "title": "Reference Ids",
      "type": "array"
    },
    "required_views": {
      "items": {
        "$ref": "#/$defs/RequiredView"
      },
      "minItems": 1,
      "title": "Required Views",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ConceptStatus",
      "default": "draft"
    },
    "style_constraints": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Style Constraints",
      "type": "array"
    },
    "subject": {
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "project_id",
    "project_bible_version_id",
    "subject",
    "gameplay_function",
    "proportions",
    "dimensions",
    "materials",
    "required_views",
    "platform_budget",
    "style_constraints",
    "concept_id",
    "version",
    "created_at",
    "updated_at",
    "authored_by"
  ],
  "title": "ConceptSpec",
  "type": "object"
}
