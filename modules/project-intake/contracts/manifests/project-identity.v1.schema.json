{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneops.local/contracts/project-identity/v1",
  "title": "SceneOps Project Identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "name", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "pattern": "^prj_[A-Za-z0-9_-]+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": ".*\\S.*" },
    "created_at": { "type": "string", "format": "date-time" },
    "copied_from_project_id": {
      "type": "string",
      "pattern": "^prj_[A-Za-z0-9_-]+$"
    }
  }
}
