{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sceneops://design-room/manifests/design-change-set/v1",
  "title": "Design ChangeSet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "changeSetId",
    "targetType",
    "targetId",
    "baseVersionId",
    "previousValue",
    "proposedValue",
    "rationale",
    "expectedResult",
    "impactScope",
    "risk",
    "validationPlan",
    "rollbackPlan",
    "approvalRequirements",
    "source",
    "status",
    "createdBy",
    "createdAt",
    "approvedBy",
    "approvedAt"
  ],
  "properties": {
    "changeSetId": { "type": "string", "minLength": 1 },
    "targetType": { "enum": ["project-bible", "feature-spec"] },
    "targetId": { "type": "string", "minLength": 1 },
    "baseVersionId": { "type": "string", "minLength": 1 },
    "previousValue": { "type": "object" },
    "proposedValue": { "type": "object" },
    "rationale": { "type": "string", "minLength": 1 },
    "expectedResult": { "type": "string", "minLength": 1 },
    "impactScope": { "type": "array", "items": { "type": "string" } },
    "risk": { "enum": ["low", "medium", "high"] },
    "validationPlan": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rollbackPlan": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "approvalRequirements": { "const": ["design:approve"] },
    "source": { "const": "assistant" },
    "status": { "enum": ["waiting-approval", "approved", "rejected", "applied"] },
    "createdBy": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "approvedBy": { "type": ["string", "null"] },
    "approvedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
