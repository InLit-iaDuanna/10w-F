{
  "x-event-type": "design.feature_spec.marked_ready",
  "x-event-version": 1,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sceneops://design-room/events/design.feature_spec.marked_ready/v1",
  "title": "design.feature_spec.marked_ready@1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "featureSpecId",
    "featureVersionId",
    "dependencyIds",
    "acceptanceCriterionIds",
    "requiredDeliverables",
    "requiredTestIds"
  ],
  "properties": {
    "featureSpecId": { "type": "string", "minLength": 1 },
    "featureVersionId": { "type": "string", "minLength": 1 },
    "dependencyIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "acceptanceCriterionIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "requiredDeliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirementId", "kind"],
        "properties": {
          "requirementId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["asset", "scene", "script", "ui", "audio", "vfx"] }
        }
      }
    },
    "requiredTestIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
  }
}
