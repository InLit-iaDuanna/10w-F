        "mask_artifact_id": {
          "minLength": 1,
          "title": "Mask Artifact Id",
          "type": "string"
        },
        "max_changed_ratio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Max Changed Ratio",
          "type": "number"
        },
        "object_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Object Ids",
          "type": "array"
        },
        "region_id": {
          "minLength": 1,
          "title": "Region Id",
          "type": "string"
        }
      },
      "required": [
        "region_id",
        "object_ids",
        "mask_artifact_id",
        "max_changed_ratio"
      ],
      "title": "ProtectedRegion",
      "type": "object"
    },
    "ProtectedRegionResult": {
      "additionalProperties": false,
      "properties": {
        "changed_pixel_ratio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Changed Pixel Ratio",
          "type": "number"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "region_id": {
          "minLength": 1,
          "title": "Region Id",
          "type": "string"
        },
        "threshold": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "region_id",
        "changed_pixel_ratio",
        "threshold",
        "passed"
      ],
