{
  "$defs": {
    "AovArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "pass_type": {
          "$ref": "#/$defs/AovPass"
        },
        "scene": {
          "$ref": "#/$defs/SceneCameraRef"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "pass_type",
        "scene",
        "width",
        "height",
        "artifact"
      ],
      "title": "AovArtifact",
      "type": "object"
    },
    "AovDependencySnapshot": {
      "additionalProperties": false,
      "properties": {
        "camera_version": {
          "minLength": 1,
          "title": "Camera Version",
          "type": "string"
        },
        "geometry_version": {
          "minLength": 1,
          "title": "Geometry Version",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "lighting_version": {
          "minLength": 1,
          "title": "Lighting Version",
          "type": "string"
        },
        "material_version": {
          "minLength": 1,
          "title": "Material Version",
          "type": "string"
        },
        "recipe_id": {
          "minLength": 1,
          "title": "Recipe Id",
          "type": "string"
        },
        "recipe_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Recipe Version",
          "type": "string"
        },
        "renderer_version": {
          "minLength": 1,
          "title": "Renderer Version",
          "type": "string"
        },
        "samples": {
          "exclusiveMinimum": 0,
          "title": "Samples",
          "type": "integer"
        },
        "visibility_version": {
          "minLength": 1,
          "title": "Visibility Version",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "recipe_id",
        "recipe_version",
        "geometry_version",
        "camera_version",
        "material_version",
        "lighting_version",
        "visibility_version",
        "renderer_version",
        "samples",
        "width",
        "height"
      ],
      "title": "AovDependencySnapshot",
      "type": "object"
    },
    "AovPass": {
      "enum": [
        "beauty",
        "depth",
        "normal",
        "albedo",
        "object_id",
        "material_id"
      ],
      "title": "AovPass",
      "type": "string"
    },
    "ApprovalState": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "ApprovalState",
      "type": "string"
    },
    "ArtifactApprovalState": {
      "enum": [
        "not_required",
        "pending",
        "approved",
        "rejected"
      ],
      "title": "ArtifactApprovalState",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "approval_state": {
          "$ref": "#/$defs/ArtifactApprovalState"
        },
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "checksum_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checksum Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "creator": {
          "minLength": 1,
          "title": "Creator",
          "type": "string"
        },
        "execution_mode": {
          "$ref": "#/$defs/ExecutionMode"
        },
        "producing_module": {
          "minLength": 1,
          "title": "Producing Module",
          "type": "string"
        },
        "related_sceneops_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Sceneops Ids",
          "type": "array"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_project_id": {
          "minLength": 1,
          "title": "Source Project Id",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "tool_name": {
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "uri",
        "checksum_sha256",
        "source_project_id",
        "source_version",
        "producing_module",
        "tool_name",
        "tool_version",
        "creator",
        "approval_state",
        "execution_mode",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CachePlan": {
      "additionalProperties": false,
      "properties": {
        "capture_passes": {
          "items": {
            "$ref": "#/$defs/AovPass"
          },
          "title": "Capture Passes",
          "type": "array"
        },
        "reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "$ref": "#/$defs/AovPass"
          },
          "title": "Reasons",
          "type": "object"
        },
        "reused_passes": {
          "items": {
            "$ref": "#/$defs/AovPass"
          },
          "title": "Reused Passes",
          "type": "array"
        }
      },
      "title": "CachePlan",
      "type": "object"
    },
    "DifferenceMetrics": {
      "additionalProperties": false,
      "properties": {
        "artistic_quality_measured": {
          "const": false,
          "default": false,
          "title": "Artistic Quality Measured",
          "type": "boolean"
        },
        "changed_pixel_ratio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Changed Pixel Ratio",
          "type": "number"
        },
        "maximum_channel_difference": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Maximum Channel Difference",
          "type": "number"
        },
        "mean_absolute_difference": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Absolute Difference",
          "type": "number"
        }
      },
      "required": [
        "mean_absolute_difference",
        "changed_pixel_ratio",
        "maximum_channel_difference"
      ],
      "title": "DifferenceMetrics",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "live",
        "cached",
        "mock",
        "planned",
        "blocked"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "JobFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "suggested_actions": {
          "items": {
            "type": "string"
          },
          "title": "Suggested Actions",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "JobFailure",
      "type": "object"
    },
    "ProtectedRegion": {
      "additionalProperties": false,
