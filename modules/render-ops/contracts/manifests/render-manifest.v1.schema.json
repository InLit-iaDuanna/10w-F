      "enum": [
        "queued",
        "running",
        "waiting_approval",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RenderJobState",
      "type": "string"
    },
    "RenderRecipe": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/RecipeKind"
        },
        "optional_passes": {
          "items": {
            "$ref": "#/$defs/AovPass"
          },
          "title": "Optional Passes",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "recipe_id": {
          "minLength": 1,
          "title": "Recipe Id",
          "type": "string"
        },
        "required_passes": {
          "items": {
            "$ref": "#/$defs/AovPass"
          },
          "minItems": 1,
          "title": "Required Passes",
          "type": "array"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        },
        "workflow_checksum_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Checksum Sha256"
        },
        "workflow_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Reference"
        }
      },
      "required": [
        "recipe_id",
        "version",
        "kind",
        "required_passes"
      ],
      "title": "RenderRecipe",
      "type": "object"
    },
