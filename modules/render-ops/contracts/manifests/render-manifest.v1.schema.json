    "RenderJob": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "brief_id": {
          "minLength": 1,
          "title": "Brief Id",
          "type": "string"
        },
        "cache_plan": {
          "$ref": "#/$defs/CachePlan"
