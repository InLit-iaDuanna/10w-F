        "before_artifact_id": {
          "minLength": 1,
          "title": "Before Artifact Id",
          "type": "string"
        },
        "changed_object_ids": {
          "items": {
            "type": "string"
          },
          "title": "Changed Object Ids",
          "type": "array"
        },
        "comparison_id": {
          "minLength": 1,
          "title": "Comparison Id",
          "type": "string"
        },
        "execution_mode": {
          "$ref": "#/$defs/ExecutionMode"
