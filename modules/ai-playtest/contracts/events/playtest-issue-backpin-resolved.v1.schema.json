{
  "$defs": {
    "Backpin": {
      "additionalProperties": false,
      "properties": {
        "backpin_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Backpin Id",
          "type": "string"
        },
        "source_record_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Id"
        },
        "source_record_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Uri"
        },
        "target_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/BackpinTargetType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "sceneops_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sceneops Id"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "owning_module": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owning Module"
        },
        "status": {
          "$ref": "#/$defs/BackpinStatus"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "alternatives": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        }
      },
      "required": [
        "backpin_id",
        "status",
        "confidence",
        "evidence_ids",
        "reasons"
      ],
      "title": "Backpin",
      "type": "object"
    },
    "BackpinStatus": {
      "enum": [
        "resolved",
        "ambiguous",
        "unresolved",
        "rejected"
      ],
      "title": "BackpinStatus",
      "type": "string"
    },
    "BackpinTargetType": {
      "enum": [
        "scene_object",
        "asset",
        "component",
        "script",
        "feature",
        "acceptance_criterion"
      ],
      "title": "BackpinTargetType",
      "type": "string"
    },
    "EventActor": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "user",
            "agent",
            "system"
          ],
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "EventActor",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "live",
        "cached",
        "mock",
        "planned",
        "blocked"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "PlaytestIssueBackpinResolvedPayload": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Issue Id",
          "type": "string"
        },
        "backpin": {
          "$ref": "#/$defs/Backpin"
        },
        "execution_mode": {
          "$ref": "#/$defs/ExecutionMode"
        }
      },
      "required": [
        "issue_id",
        "backpin",
        "execution_mode"
      ],
      "title": "PlaytestIssueBackpinResolvedPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Event Id",
      "type": "string"
    },
    "event_version": {
      "const": 1,
      "default": 1,
      "title": "Event Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "project_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Correlation Id",
      "type": "string"
    },
    "causation_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Causation Id",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/EventActor"
    },
    "mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "event_type": {
      "const": "playtest.issue.backpin.resolved",
      "default": "playtest.issue.backpin.resolved",
      "title": "Event Type",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/PlaytestIssueBackpinResolvedPayload"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "project_id",
    "correlation_id",
    "causation_id",
    "actor",
    "mode",
    "payload"
  ],
  "title": "PlaytestIssueBackpinResolvedEvent",
  "type": "object"
}
