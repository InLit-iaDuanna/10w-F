{
  "$defs": {
    "ActionKind": {
      "enum": [
        "move",
        "look",
        "interact",
        "use_item",
        "confirm",
        "cancel",
        "registered"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "ActionOutcome": {
      "enum": [
        "succeeded",
        "failed",
        "timed_out",
        "cancelled"
      ],
      "title": "ActionOutcome",
      "type": "string"
    },
    "ActionResult": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "$ref": "#/$defs/ActionOutcome"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "feedback": {
          "items": {
            "type": "string"
          },
          "title": "Feedback",
          "type": "array"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        }
      },
      "required": [
        "outcome",
        "duration_ms"
      ],
      "title": "ActionResult",
      "type": "object"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "execution_mode": {
          "$ref": "#/$defs/ExecutionMode"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "source_project_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Project Id",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "related_sceneops_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Related Sceneops Ids",
          "type": "array"
        },
        "producing_module": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Producing Module",
          "type": "string"
        },
        "tool_name": {
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        },
        "workflow_version": {
          "minLength": 1,
          "title": "Workflow Version",
          "type": "string"
        },
        "creator_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Creator Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "approval_state": {
          "enum": [
            "unreviewed",
            "approved",
            "rejected"
          ],
          "title": "Approval State",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "execution_mode",
        "source_project_id",
        "source_version",
        "producing_module",
        "tool_name",
        "tool_version",
        "workflow_version",
        "creator_id",
        "created_at",
        "approval_state"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "AvailableAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Action Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "target_sceneops_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Sceneops Id"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "advances_goal_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Advances Goal Ids",
          "type": "array"
        },
        "goal_relevance": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Goal Relevance",
          "type": "number"
        },
        "destructive": {
          "default": false,
          "title": "Destructive",
          "type": "boolean"
        },
        "registered_action_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registered Action Id"
        },
        "feedback_expected": {
          "default": false,
          "title": "Feedback Expected",
          "type": "boolean"
        }
      },
      "required": [
        "action_id",
        "kind",
        "label"
      ],
      "title": "AvailableAction",
      "type": "object"
    },
    "CameraEvidence": {
      "additionalProperties": false,
      "properties": {
        "camera_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Camera Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "field_of_view_deg": {
          "exclusiveMaximum": 180,
          "exclusiveMinimum": 0,
          "title": "Field Of View Deg",
          "type": "number"
        },
        "screenshot_artifact_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screenshot Artifact Id"
        }
      },
      "required": [
        "camera_id",
        "pose",
        "field_of_view_deg"
      ],
      "title": "CameraEvidence",
      "type": "object"
