        "step_indices": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Step Indices",
          "type": "array"
        },
        "target_sceneops_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Sceneops Id"
        },
        "evidence_artifact_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
