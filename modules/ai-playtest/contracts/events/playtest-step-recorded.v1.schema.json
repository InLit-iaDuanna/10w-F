          "type": "array"
        },
        "runtime_errors": {
          "items": {
            "$ref": "#/$defs/RuntimeErrorRecord"
          },
          "title": "Runtime Errors",
          "type": "array"
        },
        "frame_time_ms": {
          "minimum": 0,
          "title": "Frame Time Ms",
          "type": "number"
        },
        "memory_mb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
