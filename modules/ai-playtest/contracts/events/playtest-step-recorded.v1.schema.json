        "trajectory": {
          "items": {
            "$ref": "#/$defs/Pose"
          },
          "minItems": 1,
          "title": "Trajectory",
          "type": "array"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "structured_log_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Structured Log Ids",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "run_id",
        "session_id",
        "execution_mode",
        "captured_at",
        "build_id",
        "scene_id",
        "step_indices",
        "camera",
        "trajectory"
