          "title": "Goal Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/GoalState"
        },
        "value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "goal_id",
        "state",
        "value"
      ],
