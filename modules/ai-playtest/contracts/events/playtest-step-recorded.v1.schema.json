    },
    "FailureKind": {
      "enum": [
        "timeout",
        "stall",
        "soft_lock",
        "unreachable_goal",
        "repeated_failed_interaction",
        "navigation_error",
        "collider_error",
        "missing_feedback",
        "quest_state_mismatch",
        "runtime_error",
        "performance_regression",
        "telemetry_loss"
