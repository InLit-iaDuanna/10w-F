          "title": "Status",
          "type": "string"
        },
        "limitation_labels": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitation Labels",
          "type": "array"
        }
      },
      "required": [
        "issue_id",
        "run_id",
        "test_case_id",
        "title",
        "created_at",
        "execution_mode",
        "failure_signal",
        "evidence",
        "backpin",
        "restoration",
        "limitation_labels"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/Vector3"
