    "mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "event_type": {
      "const": "playtest.issue.created",
      "default": "playtest.issue.created",
      "title": "Event Type",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/Issue"
    }
