      "title": "Correlation Id",
      "type": "string"
    },
    "causation_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Causation Id",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/EventActor"
