        "coordinate_space": {
          "const": "unity_world",
          "default": "unity_world",
          "title": "Coordinate Space",
          "type": "string"
        },
        "axis_convention": {
          "const": "left_handed_y_up_z_forward",
          "default": "left_handed_y_up_z_forward",
          "title": "Axis Convention",
          "type": "string"
        },
        "distance_unit": {
          "const": "meter",
          "default": "meter",
          "title": "Distance Unit",
          "type": "string"
        }
