            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Id"
        },
        "source_record_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Uri"
        },
        "target_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/BackpinTargetType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
