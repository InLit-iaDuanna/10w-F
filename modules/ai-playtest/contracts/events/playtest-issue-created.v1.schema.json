        },
        "build_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Build Id",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Scene Id",
          "type": "string"
        },
        "step_indices": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Step Indices",
          "type": "array"
        },
        "camera": {
          "$ref": "#/$defs/CameraEvidence"
        },
        "trajectory": {
          "items": {
            "$ref": "#/$defs/Pose"
          },
          "minItems": 1,
          "title": "Trajectory",
          "type": "array"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "structured_log_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Structured Log Ids",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "run_id",
        "session_id",
        "execution_mode",
        "captured_at",
        "build_id",
        "scene_id",
        "step_indices",
        "camera",
        "trajectory"
      ],
      "title": "EvidenceBundle",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "live",
        "cached",
        "mock",
        "planned",
        "blocked"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "FailureKind": {
      "enum": [
        "timeout",
        "stall",
        "soft_lock",
        "unreachable_goal",
        "repeated_failed_interaction",
        "navigation_error",
        "collider_error",
        "missing_feedback",
        "quest_state_mismatch",
        "runtime_error",
        "performance_regression",
        "telemetry_loss"
