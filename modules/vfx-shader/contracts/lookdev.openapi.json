  "components": {
    "schemas": {
      "ApplyLookdevRequest": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "document_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Document Version"
          },
          "expected_target_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Target Version"
          },
          "expected_scene_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Scene Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "document_version",
          "expected_target_version"
        ],
        "title": "ApplyLookdevRequest"
      },
      "ExportLookdevRequest": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "document_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Document Version"
          },
          "format": {
            "type": "string",
            "enum": [
              "pbr-glb",
              "shader-zip",
              "luma-zip"
            ],
            "title": "Format"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "document_version",
          "format"
        ],
        "title": "ExportLookdevRequest"
      },
      "FinishLookdevTurnRequest": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "applied",
              "failed",
              "cancelled",
              "declined",
              "noop"
            ],
            "title": "Status"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "FinishLookdevTurnRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LookdevApplication": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "document_version": {
            "type": "integer",
            "title": "Document Version"
          },
          "asset_id": {
            "type": "string",
            "title": "Asset Id"
          },
          "asset_version": {
            "type": "integer",
            "title": "Asset Version"
          },
          "scene_instance_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scene Instance Id"
          },
          "state": {
            "additionalProperties": true,
            "type": "object",
            "title": "State"
          },
          "runtime_module": {
            "type": "string",
            "title": "Runtime Module"
          },
          "scene_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scene Version"
          },
          "needs_build": {
            "type": "boolean",
            "title": "Needs Build",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "document_version",
          "asset_id",
          "asset_version",
          "state",
          "runtime_module"
        ],
        "title": "LookdevApplication"
      },
      "LookdevDocument": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "minLength": 1,
            "title": "Project Id"
          },
          "version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Version",
            "default": 0
          },
          "target": {
            "$ref": "#/components/schemas/LookdevTarget"
          },
          "state": {
            "additionalProperties": true,
            "type": "object",
            "title": "State"
          },
          "runtime_module": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runtime Module"
          },
          "history": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "History"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "project_id",
          "target",
          "state"
        ],
        "title": "LookdevDocument"
      },
      "LookdevExport": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "document_version": {
            "type": "integer",
            "title": "Document Version"
          },
          "format": {
            "type": "string",
            "enum": [
              "pbr-glb",
              "shader-zip",
              "luma-zip"
            ],
            "title": "Format"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "download_url": {
            "type": "string",
            "title": "Download Url"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "project_id",
          "document_id",
          "document_version",
          "format",
          "filename",
          "media_type",
          "size_bytes",
          "download_url"
        ],
        "title": "LookdevExport"
      },
      "LookdevProposal": {
        "properties": {
          "turn_id": {
            "type": "string",
            "title": "Turn Id"
          },
          "operations": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Operations"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "base_version": {
            "type": "integer",
            "title": "Base Version"
          },
          "target": {
            "$ref": "#/components/schemas/LookdevTarget"
          },
          "state": {
            "additionalProperties": true,
            "type": "object",
            "title": "State"
          },
          "status": {
            "type": "string",
            "enum": [
              "applied",
              "declined",
              "noop"
            ],
            "title": "Status",
            "default": "applied"
          },
          "execution_mode": {
            "type": "string",
            "const": "live",
            "title": "Execution Mode",
            "default": "live"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "turn_id",
          "operations",
          "summary",
          "base_version",
          "target",
          "state"
        ],
        "title": "LookdevProposal"
      },
      "LookdevProposalRequest": {
        "properties": {
          "turn_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Turn Id"
          },
          "document": {
            "$ref": "#/components/schemas/LookdevDocument"
