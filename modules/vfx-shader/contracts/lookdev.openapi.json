          "prompt": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Prompt"
          },
          "allow_lighting": {
            "type": "boolean",
            "title": "Allow Lighting",
            "default": false
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "material_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Material Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document",
          "prompt"
        ],
        "title": "LookdevProposalRequest"
      },
      "LookdevTarget": {
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "title": "Asset Id"
          },
          "asset_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Asset Version"
          },
          "scene_instance_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scene Instance Id"
          },
          "sceneops_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sceneops Id"
          },
          "material_slot": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
