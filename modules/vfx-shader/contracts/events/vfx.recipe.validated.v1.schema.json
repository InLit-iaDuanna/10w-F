{
  "x-event-type": "vfx.recipe.validated",
  "x-event-version": 1,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sceneops://vfx-shader/events/vfx.recipe.validated@1",
  "title": "VFX recipe validated event intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "occurred_at", "project_id", "correlation_id", "causation_id", "actor", "mode", "payload"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^evt_"},
    "event_type": {"const": "vfx.recipe.validated"},
    "event_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "project_id": {"type": "string", "pattern": "^prj_"},
    "correlation_id": {"type": "string", "pattern": "^corr_"},
    "causation_id": {"type": "string", "pattern": "^cmd_"},
    "actor": {"type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": {"type": {"enum": ["user", "agent", "system"]}, "id": {"type": "string", "minLength": 1}}},
    "mode": {"enum": ["live", "cached", "mock", "planned", "blocked"]},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe_id", "recipe_version", "warning_codes"],
      "properties": {
        "recipe_id": {"type": "string", "pattern": "^vfxrec_"},
        "recipe_version": {"type": "string", "minLength": 1},
        "warning_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
