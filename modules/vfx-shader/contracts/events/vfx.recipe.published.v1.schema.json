{
  "x-event-type": "vfx.recipe.published",
  "x-event-version": 1,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sceneops://vfx-shader/events/vfx.recipe.published@1",
  "title": "VFX recipe published event intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "occurred_at", "project_id", "correlation_id", "causation_id", "actor", "mode", "payload"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^evt_"},
    "event_type": {"const": "vfx.recipe.published"},
    "event_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "project_id": {"type": "string", "pattern": "^prj_"},
    "correlation_id": {"type": "string", "pattern": "^corr_"},
    "causation_id": {"type": "string", "pattern": "^cmd_"},
    "actor": {"type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": {"type": {"enum": ["user", "agent", "system"]}, "id": {"type": "string", "minLength": 1}}},
    "mode": {"enum": ["live", "cached", "mock"]},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe_id", "recipe_version", "change_set_id", "target_sceneops_ids", "adapter_result_id"],
      "properties": {
        "recipe_id": {"type": "string", "pattern": "^vfxrec_"},
        "recipe_version": {"type": "string", "minLength": 1},
        "change_set_id": {"type": "string", "pattern": "^chg_"},
        "target_sceneops_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^so_"}, "uniqueItems": true},
        "adapter_result_id": {"type": ["string", "null"]}
      }
    }
  }
}
