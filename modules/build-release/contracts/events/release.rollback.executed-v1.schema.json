{
  "$defs": {
    "ExecutionMode": {
      "enum": [
        "live",
        "cached",
        "mock",
        "planned",
        "blocked"
      ],
      "title": "ExecutionMode",
      "type": "string"
    }
  },
  "properties": {
    "activated_candidate_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
      "title": "Activated Candidate Id",
      "type": "string"
    },
    "activation_deployment_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
      "title": "Activation Deployment Id",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "previous_deployment_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
      "title": "Previous Deployment Id",
      "type": "string"
    },
    "rollback_plan_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$",
      "title": "Rollback Plan Id",
      "type": "string"
    }
  },
  "required": [
    "rollback_plan_id",
    "previous_deployment_id",
    "activation_deployment_id",
    "activated_candidate_id",
    "mode"
  ],
  "title": "ReleaseRollbackExecutedPayload",
  "type": "object"
}
