                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "started_at"
        ],
        "title": "ExportNativeRun"
      },
      "ExportPlatformRun": {
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "mac-arm64",
              "mac-x64",
              "win-x64"
            ],
            "title": "Platform"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "interrupted",
              "blocked"
            ],
            "title": "Status",
            "default": "queued"
          },
          "attempts": {
            "items": {
              "$ref": "#/components/schemas/ExportAttempt"
            },
            "type": "array",
            "title": "Attempts"
          },
          "verification": {
            "type": "string",
            "enum": [
              "pending",
              "passed",
              "failed"
            ],
            "title": "Verification",
            "default": "pending"
          },
          "verification_notes": {
            "type": "string",
            "title": "Verification Notes",
            "default": ""
          },
          "verification_device": {
            "type": "string",
            "title": "Verification Device",
            "default": ""
          },
          "verification_attempt_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verification Attempt Id"
          }
        },
        "type": "object",
        "required": [
          "platform"
        ],
        "title": "ExportPlatformRun"
      },
      "ExportSettings": {
        "properties": {
          "app_name": {
            "type": "string",
            "maxLength": 120,
            "title": "App Name",
            "default": ""
          },
          "app_id": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^$|^[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z][a-zA-Z0-9_]*)+$",
            "title": "App Id",
            "default": ""
          },
          "orientation": {
            "type": "string",
            "enum": [
              "landscape",
              "portrait"
            ],
            "title": "Orientation",
            "default": "landscape"
          },
          "allow_dependency_install": {
            "type": "boolean",
            "title": "Allow Dependency Install",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ExportSettings"
      },
      "ExportTask": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "source_version": {
            "type": "string",
            "title": "Source Version"
          },
          "previous_task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Task Id"
          },
          "settings": {
            "$ref": "#/components/schemas/ExportSettings"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "mode": {
            "type": "string",
            "enum": [
              "live",
              "mock",
              "blocked",
              "planned"
            ],
            "title": "Mode",
            "default": "live"
          },
          "platforms": {
            "items": {
              "$ref": "#/components/schemas/ExportPlatformRun"
            },
            "type": "array",
            "title": "Platforms"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ExportMessage"
            },
            "type": "array",
            "title": "Messages"
          },
          "native_runs": {
            "items": {
              "$ref": "#/components/schemas/ExportNativeRun"
            },
            "type": "array",
            "title": "Native Runs"
          },
          "revision": {
            "type": "integer",
            "title": "Revision",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "project_id",
          "source_version",
          "settings",
          "created_at",
          "updated_at",
          "platforms"
        ],
        "title": "ExportTask"
      },
      "ExportVerificationRequest": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "passed",
              "failed"
            ],
            "title": "Status"
          },
          "notes": {
            "type": "string",
            "maxLength": 4000,
            "title": "Notes",
            "default": ""
          },
          "device": {
            "type": "string",
            "maxLength": 200,
            "title": "Device",
            "default": ""
          },
          "attempt_id": {
            "type": "string",
            "title": "Attempt Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "attempt_id"
        ],
        "title": "ExportVerificationRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
