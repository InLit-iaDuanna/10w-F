{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneops.dev/contracts/manifests/blender-export-manifest.schema.json",
  "title": "SceneOps Blender export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "source_asset_id",
    "asset_version_id",
    "object_identities",
    "artifacts",
    "execution_mode",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "source_asset_id": {"type": "string", "minLength": 1},
    "asset_version_id": {"type": "string", "minLength": 1},
    "object_identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sceneops_id", "source_object_locator"],
        "properties": {
          "sceneops_id": {"type": "string", "minLength": 1},
          "source_object_locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifacts": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "execution_mode": {"enum": ["live", "cached", "mock", "planned", "blocked"]},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
